# 统一 LF，避免 Windows 检出把 CRLF 带进 Markdown/frontmatter
* text=auto eol=lf

*.md text eol=lf
*.mdx text eol=lf
*.json text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.astro text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.css text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary

package-lock.json linguist-generated=true
docs/**.md linguist-documentation
