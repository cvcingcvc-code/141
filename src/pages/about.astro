---
/**
 * 关于 — /about/（C-9 #2）
 * 读 profile；profile 未发布时显示空态，不硬编码任何个人信息。
 */
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { getProfile } from '../lib/collections';
import { formatDate, href } from '../lib/format';

const profile = await getProfile();
const d = profile?.data;
const Content = profile ? (await render(profile)).Content : null;
---

<Base title="关于" description="这个知识库是什么，以及内容如何被发布。">
  <header class="page-head">
    <h1>{d?.title ?? '关于'}</h1>
    {d?.summary && <p class="page-head__desc">{d.summary}</p>}
  </header>

  {
    !profile || !Content ? (
      <div class="empty-state">
        <p class="empty-state__title">个人介绍尚未发布</p>
        <p class="empty-state__desc">
          <code>content/profile/profile.md</code> 存在，但尚未由本人确认发布（<code>published: true</code> + <code>published_by: user</code>）。
          在确认之前，这里不会展示任何个人信息。
        </p>
      </div>
    ) : (
      <article class="entry">
        {d?.sample && <p><span class="badge badge--sample">示例</span> 以下为示例数据，不是真实个人介绍。</p>}
        <div class="prose">
          <Content />
        </div>
        <p class="entry__meta">
          <time datetime={d?.updated}>更新于 {formatDate(d?.updated)}</time>
        </p>
      </article>
    )
  }

  <section class="related">
    <h2 class="related__title">内容是怎么上站的</h2>
    <ol class="steps">
      <li>写 Markdown 到 <code>content/</code>，带受控 frontmatter（字段见 <code>docs/CONTRACTS.md</code>）。</li>
      <li>提交 PR：CI 跑范围门禁、内容校验、契约测试、类型检查与构建。</li>
      <li>本人确认后合并到 <code>main</code>；只有 <code>main</code> 会被部署。</li>
      <li>条目必须显式 <code>published: true</code> 且 <code>published_by: user</code> 才会出现在站点与搜索索引里。</li>
    </ol>
    <p class="empty-state__desc">
      没有来源的知识会标「未标注来源」，示例数据会标「示例」，都不会被当成真实验证过的内容。
      <a href={href('/knowledge/')}>看看知识库</a>。
    </p>
  </section>
</Base>
